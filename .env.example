# ============================================================================
# Flutter Environment Variables Template
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# App Configuration
# ============================================================================
APP_NAME=JobConnect
APP_VERSION=1.0.0

# ============================================================================
# API Configuration
# IMPORTANT: Change IP address to your computer's local IP
# Find your IP:
#   Windows: ipconfig
#   Mac/Linux: ifconfig or ip addr show
# For Android Emulator: Use 10.0.2.2 instead of localhost
# ============================================================================
API_BASE_URL=http://192.168.1.XXX:5000/api/v1
SOCKET_URL=http://192.168.1.XXX:5000
FLUTTER_ENV=development

# Production (when deploying)
# API_BASE_URL=https://api.yourapp.com/api/v1
# SOCKET_URL=https://api.yourapp.com
# FLUTTER_ENV=production

# ============================================================================
# Firebase Configuration - COMMON
# Get from Firebase Console > Project Settings
# ============================================================================
IOS_BUNDLE_ID=com.example.jobconnect
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# ============================================================================
# Firebase - WEB Configuration
# Get from Firebase Console > Project Settings > Web App
# ============================================================================
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_WEB_APP_ID=1:your-sender-id:web:your-web-app-id
FIREBASE_WEB_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================================
# Firebase - ANDROID Configuration
# Get from Firebase Console > Project Settings > Android App
# Download google-services.json and place in android/app/
# ============================================================================
FIREBASE_ANDROID_API_KEY=your-android-api-key
FIREBASE_ANDROID_APP_ID=1:your-sender-id:android:your-android-app-id
FIREBASE_ANDROID_CLIENT_ID=your-sender-id-xxxxx.apps.googleusercontent.com

# ============================================================================
# Firebase - iOS Configuration
# Get from Firebase Console > Project Settings > iOS App
# Download GoogleService-Info.plist and place in ios/Runner/
# ============================================================================
FIREBASE_IOS_API_KEY=your-ios-api-key
FIREBASE_IOS_APP_ID=1:your-sender-id:ios:your-ios-app-id
FIREBASE_IOS_BUNDLE_ID=com.example.jobconnect
FIREBASE_IOS_CLIENT_ID=your-sender-id-xxxxx.apps.googleusercontent.com

# ============================================================================
# Firebase - WINDOWS Configuration (Optional)
# ============================================================================
FIREBASE_WINDOWS_API_KEY=your-windows-api-key
FIREBASE_WINDOWS_APP_ID=1:your-sender-id:web:your-windows-app-id
FIREBASE_WINDOWS_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================================
# OAuth Configuration
# ============================================================================

# GitHub OAuth
# Get from: https://github.com/settings/developers
# Set Authorization callback URL: com.jobconnect://auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_REDIRECT_URI=com.jobconnect://auth/github/callback

# Twitter OAuth 2.0
# Get from: https://developer.twitter.com/en/portal/dashboard
# Set Callback URL: com.jobconnect://auth/twitter/callback
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_REDIRECT_URI=com.jobconnect://auth/twitter/callback

# Microsoft OAuth (Optional)
# Get from: https://portal.azure.com/ > App Registrations
# Set Redirect URI: com.jobconnect://auth/microsoft/callback
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_REDIRECT_URI=com.jobconnect://auth/microsoft/callback

# LinkedIn OAuth (Optional)
# Get from: https://www.linkedin.com/developers/apps
# Set Redirect URI: com.jobconnect://auth/linkedin/callback
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_REDIRECT_URI=com.jobconnect://auth/linkedin/callback

# ============================================================================
# Google OAuth (Native)
# The client IDs above (FIREBASE_ANDROID_CLIENT_ID, FIREBASE_IOS_CLIENT_ID)
# are used for Google Sign-In
# ============================================================================